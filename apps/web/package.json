{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:smoke": "playwright test smoke.spec.ts --project=chromium",
    "test:e2e:comprehensive": "playwright test comprehensive.spec.ts --project=chromium",
    "test:e2e:flows": "playwright test tests/flows/ --project=chromium",
    "test:e2e:teacher": "playwright test tests/flows/teacher-flow.spec.ts --project=chromium",
    "test:e2e:student": "playwright test tests/flows/student-flow.spec.ts --project=chromium",
    "test:e2e:admin": "playwright test tests/flows/admin-flow.spec.ts --project=chromium",
    "test:e2e:class": "playwright test tests/flows/class-management.spec.ts --project=chromium",
    "test:e2e:assessment": "playwright test tests/flows/assessment-flow.spec.ts --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:all": "playwright test",
    "test:e2e:quick": "playwright test smoke.spec.ts comprehensive.spec.ts --project=chromium --workers=4",
    "verify": "npm run build && npm run test:e2e:quick",
    "verify:full": "npm run build && npm run test:e2e:flows"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.0",
